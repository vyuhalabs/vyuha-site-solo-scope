---
import { getEntry, render } from "astro:content";
import Doc from "../layouts/Doc.astro";
import { ACCESS_REQUEST_URL } from "../lib/site";

const entry = await getEntry("docs", "guide");
if (!entry) throw new Error("The guide entry is missing from src/content/docs.");
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text }));
---

<Doc
  title={entry.data.title}
  description={entry.data.description}
  og="guide"
  eyebrow="Guide"
  heading={entry.data.title}
  lead="Connect a repository, create a project, file a first issue and read the evidence of the run that follows."
  toc={toc}
  cta={false}
>
  <p slot="header" class="access">
    Access is by request.{" "}
    <a href={ACCESS_REQUEST_URL}>Open an access-request issue</a>.
  </p>
  <article class="prose">
    <Content />
  </article>
</Doc>

<style>
  .access {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .access a {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
</style>
