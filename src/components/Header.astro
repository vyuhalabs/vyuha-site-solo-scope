---
import { NAV, url } from "../lib/site";

const current = Astro.url.pathname.replace(/\/?$/, "/");
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href={url("/")}>
      <span class="mark" aria-hidden="true"></span>
      <span>vyuha</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => {
            const href = url(item.href);
            const isCurrent = current === href;
            return (
              <li>
                <a href={href} aria-current={isCurrent ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    min-height: 4rem;
    padding-block: var(--space-2);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .mark {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: var(--radius-sm);
    background:
      linear-gradient(var(--color-accent), var(--color-accent)) 0 0 / 45% 45% no-repeat,
      linear-gradient(var(--color-accent), var(--color-accent)) 100% 0 / 45% 45% no-repeat,
      linear-gradient(var(--color-text), var(--color-text)) 0 100% / 45% 45% no-repeat,
      linear-gradient(var(--color-accent), var(--color-accent)) 100% 100% / 45% 45% no-repeat;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-text);
    background: var(--color-bg-subtle);
  }

  nav a[aria-current="page"] {
    color: var(--color-text);
    background: var(--color-bg-subtle);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  @media (max-width: 26rem) {
    nav a {
      padding-inline: var(--space-2);
    }
  }
</style>
