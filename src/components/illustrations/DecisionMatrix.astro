---
interface Props {
  caption?: string;
}
const { caption = "The decision matrix: each kind of action has a tier." } = Astro.props;

const tiers = ["Autonomous", "Notify", "Approve"] as const;
const rows: { action: string; tier: (typeof tiers)[number] }[] = [
  { action: "Run tests and linters", tier: "Autonomous" },
  { action: "Open a pull request", tier: "Autonomous" },
  { action: "Merge a dependency update", tier: "Notify" },
  { action: "Merge a feature", tier: "Approve" },
  { action: "Spend above the cycle threshold", tier: "Approve" },
  { action: "Release to production", tier: "Approve" },
];
---

<figure class="illustration">
  <div class="ui-frame" aria-hidden="true">
    <div class="ui-bar">
      <span>Decision policy</span>
      <span class="ui-chip">Billing service</span>
    </div>
    <div class="wrap">
      <div class="matrix">
        <div class="cell head action">Action</div>
        {tiers.map((t) => <div class="cell head tier">{t}</div>)}
        {
          rows.map((r) => (
            <>
              <div class="cell action">
                <span>{r.action}</span>
                <span class="ui-chip ui-chip-accent compact">{r.tier}</span>
              </div>
              {tiers.map((t) => (
                <div class="cell tier">
                  <span class:list={["mark", { on: t === r.tier }]} />
                </div>
              ))}
            </>
          ))
        }
      </div>
      <p class="legend">
        <span><b>Autonomous</b> agents act and record it.</span>
        <span><b>Notify</b> a person is told and may object.</span>
        <span><b>Approve</b> a person decides first, in the Inbox.</span>
        <span class="rule">vyuha merges after review and verification, and the decision tier says whether a person approves first or may object.</span>
      </p>
    </div>
  </div>
  <figcaption>
    {caption}
    <span class="visually-hidden">
      The illustration shows a decision policy for a billing service. Autonomous: run tests and
      linters, open a pull request. Notify, where a person is told and may object: merge a dependency
      update. Approve, where a person decides first in the Inbox: merge a feature, spend above the
      cycle threshold, release to production. vyuha merges after review and verification, and the decision tier says whether a person approves first or may object.
    </span>
  </figcaption>
</figure>

<style>
  .wrap {
    container-type: inline-size;
    padding: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  .matrix {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .cell {
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .cell.action {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .head,
  .tier {
    display: none;
  }

  .mark {
    display: block;
    width: 0.875rem;
    height: 0.875rem;
    margin-inline: auto;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border-strong);
  }

  .mark.on {
    width: 1.125rem;
    height: 1.125rem;
    border: 0;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .legend {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .legend .rule {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .legend b {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  @container (min-width: 30rem) {
    .matrix {
      grid-template-columns: minmax(0, 1fr) repeat(3, 5.75rem);
    }

    .head,
    .tier {
      display: block;
    }

    .compact {
      display: none;
    }

    .head {
      background: var(--color-bg-subtle);
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
      color: var(--color-text-muted);
    }

    .tier {
      text-align: center;
      border-left: 1px solid var(--color-border);
    }

    .cell.tier {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .head.action {
      display: block;
    }
  }

  .matrix > :nth-last-child(-n + 4) {
    border-bottom: 0;
  }
</style>
