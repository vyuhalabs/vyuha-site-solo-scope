---
import { ACCESS_REQUEST_URL, url } from "../lib/site";

interface Props {
  title?: string;
}
const { title = "Start with the guide." } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="panel">
      <div class="text">
        <h2 id="cta-title">{title}</h2>
        <p>
          The getting-started guide walks you through the first steps once you have access. Access
          is by request: open an issue from the access-request template and say what you want agents
          to work on.
        </p>
      </div>
      <div class="actions">
        <a class="button button-primary" href={url("/guide/")}>Read the getting-started guide</a>
        <a class="button button-secondary" href={ACCESS_REQUEST_URL}>Request access</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: var(--space-8);
  }

  .panel {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }

  @media (min-width: 64rem) {
    .panel {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      padding: var(--space-7);
      gap: var(--space-7);
    }
  }

  h2 {
    font-size: var(--text-xl);
  }

  .text {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }

  .text p {
    color: var(--color-text-muted);
  }
</style>
