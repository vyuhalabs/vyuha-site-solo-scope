---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<div class="page-header">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <slot />
  </div>
</div>

<style>
  .page-header {
    padding-block: var(--space-8) var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .container {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h1 {
    font-size: var(--text-2xl);
    max-width: 20ch;
  }
</style>
